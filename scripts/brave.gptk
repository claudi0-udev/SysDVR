back = esc
start = enter

a = mouse_left
b = mouse_right
x = f11
y = ctrl

l1 = alt_left
r1 = alt_right

l2 = pageup
r2 = pagedown

l3 = mouse_slow
r3 = esc

up = up
down = down
left = left
right = right

# Stick izquierdo: Puntero de ratón controlado y suave
left_analog_up = mouse_movement_up
left_analog_down = mouse_movement_down
left_analog_left = mouse_movement_left
left_analog_right = mouse_movement_right

# Stick derecho: Scroll progresivo y continuo (Up/Down con repetición rápida)
right_analog_up = up
right_analog_down = down
right_analog_left = alt_left
right_analog_right = alt_right

# Configuración de repetición continua (Scroll progresivo mientras se mantenga el stick)
repeat_delay = 16
repeat_rate = 25
deadzone_delay = 16

# Sensibilidad y suavidad del cursor
mouse_scale = 65
mouse_delay = 16
mouse_slow_scale = 25
